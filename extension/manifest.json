{
  "manifest_version": 3,
  "name": "Mail Mutuelle",
  "short_name": "Mail Mutuelle",
  "version": "1.3.1",
  "description": "Depuis le dossier patient, ouvre un email Gmail prérempli pour la mutuelle ou le patient, ou préremplit votre CRM.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Mail Mutuelle — réglages",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.juxta.cloud/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "host_permissions": [
    "https://*.juxta.cloud/*",
    "https://*.base44.app/*"
  ],
  "storage": {
    "managed_schema": "schema.json"
  },
  "update_url": "https://sreouven.github.io/mail-mutuelle/updates.xml"
}